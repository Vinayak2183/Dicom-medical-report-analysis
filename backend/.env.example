# Gemini (required if DR7_API_KEY is not set)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Dr7.ai medical models (recommended for best report quality)
# Get key at https://dr7.ai/access-api
DR7_API_KEY=
DR7_BASE_URL=https://dr7.ai/api/v1

# auto = prefer Dr7 if key set, else Gemini | dr7 | gemini
AI_PROVIDER=auto

# Server
HOST=127.0.0.1
PORT=8000

# Analysis
AI_SLICE_COUNT=8
MAX_UPLOAD_FILES=2000
MAX_UPLOAD_SIZE_MB=512
